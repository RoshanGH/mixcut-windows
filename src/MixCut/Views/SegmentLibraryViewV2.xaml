<UserControl x:Class="MixCut.Views.SegmentLibraryViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cards="clr-namespace:MixCut.ViewModels.Cards"
             xmlns:comp="clr-namespace:MixCut.Views.Components"
             xmlns:v="clr-namespace:MixCut.Views"
             xmlns:sl="clr-namespace:MixCut.Views.SegmentLibrary"
             xmlns:vm="clr-namespace:MixCut.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Background="{StaticResource BgPrimaryBrush}">
    <UserControl.Resources>
        <!-- 卡片尺寸对齐 mac（LazyVGrid adaptive 360~460、左栏固定 200、缩略图 200×355.6）。
             之前是 474×660：宽多 74、高多 140，全屏下一行放不下几张、一屏看不到一整行，
             用户反馈「全屏还只有 1 列、大片空白」的直接原因。 -->
        <sys:Double x:Key="SegmentCardWidth">400</sys:Double>
        <sys:Double x:Key="SegmentCardHeight">586</sys:Double>
        <!-- 9:16 竖屏画面，宽度对齐 mac 左栏的 200。 -->
        <sys:Double x:Key="SegmentCardThumbWidth">200</sys:Double>
        <sys:Double x:Key="SegmentCardThumbHeight">356</sys:Double>

        <Style x:Key="FrameStepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBlueLightBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource AccentBlueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource AccentBlueAlpha20Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel x:Name="RootDock" Margin="20,16,16,16">

        <!-- ========== 顶部工具栏 ========== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid Margin="0,0,0,8">
                <!-- 这里原本还有一个「网格 / 列表」下拉：它写的 IsGridView 在本视图里从没被读过
                     （只有已废弃的 V1 视图读），选「列表」什么都不会发生。假开关比少一个功能更伤信任，
                     已删除。真要做列表视图时，连同 ItemsPanel 的实际切换一起做。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BgQuaternaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusMd}" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="12"
                                   Foreground="{StaticResource TextQuaternaryBrush}"
                                   VerticalAlignment="Center" Margin="2,0,6,0" />
                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="12"
                                 TextChanged="OnSearchChanged" />
                        <Button Grid.Column="2" x:Name="ClearSearchButton" Content="✕"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextQuaternaryBrush}"
                                Padding="4,0" Cursor="Hand" Visibility="Collapsed"
                                Click="OnClearSearch" />
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" x:Name="SortCombo" Width="96" Margin="8,0,0,0"
                          Padding="6,4" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="按时间" IsSelected="True" />
                    <ComboBoxItem Content="按质量" />
                </ComboBox>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,6">
                <ItemsControl x:Name="TypeChipList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatsText" FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />

                <!-- 字幕字号滑块回到每张卡片（issue #23 后续）：字号已改为逐分镜存储
                    （Segment.SubtitleFontRatio），全局一份的工具栏滑块语义不再成立，已移除。 -->
                <Button Grid.Column="2" x:Name="ResetButton" Content="✕  重置筛选"
                        Background="{StaticResource BgTertiaryBrush}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        BorderThickness="0" Padding="8,3" Margin="0,0,8,0"
                        FontSize="11" Cursor="Hand"
                        Click="OnResetFilter" Visibility="Collapsed" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <!-- #17：上传自建分镜（成品分镜，不切分，只 ASR + 打标） -->
                    <Button x:Name="UploadUserSegmentButton" Content="⬆ 上传自建分镜"
                            Background="White"
                            BorderBrush="{StaticResource BorderHoverBrush}"
                            BorderThickness="1" Padding="10,3" Margin="0,0,8,0"
                            FontSize="11" Cursor="Hand"
                            ToolTip="上传已剪好的成品分镜（mp4/mov，单条 ≤15 秒，可多选），自动识别台词 + AI 打标，之后当普通分镜用"
                            Click="OnUploadUserSegment" />
                    <Button x:Name="SelectionModeButton" Content="☑ 多选"
                            Background="White"
                            BorderBrush="{StaticResource BorderHoverBrush}"
                            BorderThickness="1" Padding="10,3"
                            FontSize="11" Cursor="Hand"
                            Click="OnToggleSelectionMode" />
                </StackPanel>
            </Grid>

            <Border x:Name="SelectionToolbar" Background="{StaticResource AccentBlueLightBrush}"
                    CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SelectionCountText" Text="已选 0"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="全选" Click="OnSelectAll"
                                Background="White" BorderBrush="{StaticResource BorderHoverBrush}"
                                BorderThickness="1" Padding="9,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand" />
                        <Button Content="反选" Click="OnInvertSelection"
                                Background="White" BorderBrush="{StaticResource BorderHoverBrush}"
                                BorderThickness="1" Padding="9,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand" />
                        <Button Content="清空" Click="OnClearSelection"
                                Background="White" BorderBrush="{StaticResource BorderHoverBrush}"
                                BorderThickness="1" Padding="9,3" Margin="0,0,12,0"
                                FontSize="11" Cursor="Hand" />
                        <Button x:Name="CombineSchemeButton" Content="✨ 组合为方案"
                                Background="{StaticResource PurpleAccentBrush}" Foreground="White"
                                BorderThickness="0"
                                Padding="12,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand"
                                IsEnabled="False"
                                Click="OnCombineSchemeClick"
                                ToolTip="请至少选择 2 个分镜（按勾选顺序生成方案）"
                                ToolTipService.ShowOnDisabled="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="r" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="r" Property="Background" Value="{StaticResource PurpleAccentDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="r" Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BatchExportButton" Content="⬆ 批量导出"
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="White" BorderThickness="0"
                                Padding="12,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand"
                                Click="OnBatchExport" IsEnabled="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="r" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="r" Property="Background" Value="{StaticResource AccentBlueDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="r" Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BatchDeleteButton" Content="🗑 批量删除"
                                Background="White"
                                BorderBrush="{StaticResource DangerRedBrush}"
                                Foreground="{StaticResource DangerRedBrush}"
                                BorderThickness="1" Padding="12,3"
                                FontSize="11" Cursor="Hand"
                                Click="OnBatchDelete" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border DockPanel.Dock="Top" Height="1"
                Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,8" />

        <!-- ========== 主体 ==========
             DockPanel：检视器 Dock=Right 先占 340px（隐藏时 0 宽），分镜区填剩余宽度。
             用 DockPanel 而非 Grid：确保右侧 drawer 占位后分镜区被约束在剩余宽度内换行，
             根治「WrapPanel 无限宽测量把右列挤出屏幕」的历史怪象。 -->
        <DockPanel LastChildFill="True">

            <!-- 配音变体检视器（v0.5.0）：单击分镜后右侧 drawer（浅色 UserControl，对齐 mac） -->
            <v:DubVariantInspectorView DockPanel.Dock="Right" VerticalAlignment="Stretch" Width="340" Margin="12,0,0,0"
                                       DataContext="{Binding DubInspector}"
                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 空态必须分清三种处境，否则用户会误判：
                     ① 正在分析 —— 之前这里显示「没有符合条件的分镜」，用户以为软件坏了（真实反馈）
                     ② 一个分镜都没有 —— 该引导去导入
                     ③ 被筛选条件过滤光了 —— 该引导去重置筛选 -->
                <TextBlock x:Name="EmptyIcon" Text="🎬" FontSize="40"
                           Foreground="{StaticResource TextDisabledBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="还没有分镜" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,4" />
                <TextBlock x:Name="EmptyHint" Text="导入视频并完成 AI 分析后，分镜会出现在这里"
                           FontSize="12" TextAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                <ProgressBar x:Name="EmptyProgress" IsIndeterminate="True" Width="120" Height="4"
                             Visibility="Collapsed" Margin="0,0,0,10" />
                <Button x:Name="EmptyActionButton" Content="去导入素材"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center" Padding="14,6"
                        Visibility="Collapsed" Click="OnEmptyActionClick" />
            </StackPanel>

            <!-- 外层：按视频分组（对齐 Mac 版）。每组 = 视频 header + 该组分镜 WrapPanel（LastChildFill 填剩余） -->
            <ScrollViewer x:Name="GroupsScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupsHost" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type cards:VideoGroupViewModel}">
                            <StackPanel Margin="0,0,0,18">
                                <!-- 视频 header：缩略图 + 名称 + 分镜数 -->
                                <Border Margin="0,0,0,10" Padding="8,6"
                                        Background="{StaticResource BgSubtleBrush}"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="6"
                                                ClipToBounds="True" Background="Black"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding ThumbnailImage}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 视频编号徽章（issue #23）：与导入页徽章 / Agent video_no 同一套编号；
                                                     「自建分镜」聚合组不编号（ShowVideoNo=false）。 -->
                                                <Border Padding="7,1.5" CornerRadius="999" Margin="0,0,6,0"
                                                        Background="#9E000000" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowVideoNo, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding VideoNoText}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="700"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MetaText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 配音设置条（v0.5.0，每视频独立）：状态区 + 变体数 stepper + 克隆并改写按钮。
                                     左对齐（分镜 WrapPanel 会把组撑宽，右对齐内容会被推出可见区外）。
                                     #17：自建分镜组隐藏此条（每个自建分镜是独立载体、逐卡各自操作）。 -->
                                <Grid Margin="0,0,0,10" MinHeight="30" HorizontalAlignment="Left"
                                      Visibility="{Binding ShowDubBar, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- 主按钮 -->
                                        <Button Content="{Binding DubMainButtonText}" Command="{Binding RewriteAllCommand}"
                                                IsEnabled="{Binding IsNotDubBusy}" Cursor="Hand"
                                                Background="{StaticResource AccentBlueBrush}" Foreground="White"
                                                BorderThickness="0" Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <!-- 变体数 stepper ×N -->
                                        <Border Background="{StaticResource BgSubtleBrush}" CornerRadius="6" Padding="2"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsNotDubBusy}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−" Style="{StaticResource FrameStepButtonStyle}"
                                                        ToolTip="减少变体数" Command="{Binding DecVariantCommand}"
                                                        IsEnabled="{Binding CanDecVariant}" />
                                                <TextBlock VerticalAlignment="Center" MinWidth="28" TextAlignment="Center"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="×" /><Run Text="{Binding VariantCount, Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Content="+" Style="{StaticResource FrameStepButtonStyle}"
                                                        ToolTip="增加变体数（每分镜产出几套改写版）" Command="{Binding IncVariantCommand}"
                                                        IsEnabled="{Binding CanIncVariant}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 忙碌进度：阶段文案 + 进度条 + 百分比。
                                             可估算阶段（改写/合成）→ 百分比条 + 「N%」；
                                             不可估算阶段（分离人声/克隆）→ 无限滚动条（IsIndeterminate）传达「在动」。
                                             对齐 ImportView 的处理中进度样式（§商用丝滑标准 §1 进度反馈）。 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDubBusy, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding DubProgress}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ProgressBar Width="120" Height="5" VerticalAlignment="Center"
                                                         Minimum="0" Maximum="1"
                                                         Value="{Binding DubProgressValue, Mode=OneWay}"
                                                         IsIndeterminate="{Binding DubProgressIndeterminate}"
                                                         Foreground="{StaticResource AccentBlueBrush}"
                                                         Background="{StaticResource BgSubtleBrush}"
                                                         BorderThickness="0" />
                                            <TextBlock Text="{Binding DubPercentText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="30" />
                                            <!-- P1-5：取消整片配音 -->
                                            <Button Content="取消" Command="{Binding CancelDubCommand}" Cursor="Hand"
                                                    Margin="10,0,0,0" Padding="10,2" FontSize="11" VerticalAlignment="Center"
                                                    Background="White" Foreground="{StaticResource AccentBlueBrush}"
                                                    BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1"
                                                    ToolTip="停止本视频的配音（已生成的部分保留）" />
                                        </StackPanel>
                                        <!-- 空闲状态「✓ N 个变体」 -->
                                        <TextBlock Text="{Binding DubStatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsDubBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 该组分镜卡片：WrapPanel 排列（每组小规模，不需要 VirtualizingWrapPanel） -->
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,10,10" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type cards:SegmentCardViewModel}">
                        <Border x:Name="CardRoot"
                                Width="{StaticResource SegmentCardWidth}"
                                Height="{StaticResource SegmentCardHeight}"
                                Background="White"
                                BorderBrush="{StaticResource BorderPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="10" Padding="8"
                                Cursor="Hand"
                                ClipToBounds="True"
                                Tag="{Binding}"
                                RenderTransformOrigin="0.5,0.5"
                                PreviewMouseLeftButtonDown="OnCardClicked"
                                MouseEnter="OnCardMouseEnter"
                                MouseLeave="OnCardMouseLeave">
                            <!-- P0-6：hover 时卡片 subtle 缩放浮起（纯 RenderTransform，不碰画刷，零冻结崩溃风险） -->
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📋 复制台词"
                                              Command="{Binding PlacementTarget.Tag.CopyTranscriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="📂 在 Explorer 中显示原视频"
                                              Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="✂ 拆分分镜"
                                              Command="{Binding PlacementTarget.Tag.SplitSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="🎬 分镜头替换"
                                              Command="{Binding PlacementTarget.Tag.ReplaceShotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="♻ 删除替换画面（还原原画面）"
                                              Command="{Binding PlacementTarget.Tag.DeleteReplacedPictureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.Tag.HasReplacedPicture, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                    <Separator />
                                    <MenuItem Header="🗑 删除分镜"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueAlpha10Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueAlpha20Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <!-- P0-6：hover 缩放浮起 120ms（EnterActions 放大 / ExitActions 复位） -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         To="1.03" Duration="0:0:0.12" />
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         To="1.03" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         To="1" Duration="0:0:0.12" />
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         To="1" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <!-- 对齐 mac：横向双栏 —— 左列(缩略图+标签+配音控件+边界) | 分隔线 | 右列台词（常显·大而可读·可编辑/重识别）。
                                 左列各控件默认落在 Column 0；台词跨全部行占 Column 2；边界靠弹性行推到底。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />   <!-- 左列（缩略图宽） -->
                                    <ColumnDefinition Width="Auto" />  <!-- 分隔线 -->
                                    <ColumnDefinition Width="*" />     <!-- 右列：台词 -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- 缩略图 -->
                                    <!-- 语义标签 + 位置 + 质量分**同一行**（对齐 mac：三者共处一个 FlowLayout）。
                                         原本拆成两行，白占一行高度。 -->
                                    <RowDefinition Height="Auto" />  <!-- 标签 + 位置 + 质量 -->
                                    <RowDefinition Height="Auto" />  <!-- 字幕处理（P3） -->
                                    <RowDefinition Height="Auto" />  <!-- 帧边界 IN/OUT（常驻紧凑行） -->
                                    <RowDefinition Height="*" />     <!-- 弹性占位（底部）：吸收余量，台词跨全高 -->
                                </Grid.RowDefinitions>
                                <!-- 左右分隔线（跨全高） -->
                                <Rectangle Grid.Column="1" Grid.RowSpan="4" Width="1" Margin="8,4"
                                           Fill="{StaticResource BorderSubtleBrush}" />
                                <!-- 缩略图区 -->
                                <Border Grid.Row="0"
                                        Width="{StaticResource SegmentCardThumbWidth}"
                                        Height="{StaticResource SegmentCardThumbHeight}"
                                        Background="Black"
                                        CornerRadius="6" ClipToBounds="True">
                                    <Grid x:Name="ThumbGrid">
                                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                        <!-- 注入的 InlineVideoPlayer 必须撑满 152x270 框：ContentControl 默认内容对齐 Left/Top
                                             会让 player 缩到内容尺寸（hover 播放不铺满的结构性根因），显式 Stretch 撑满。 -->
                                        <ContentControl x:Name="VideoHost"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch" />

                                        <!-- 编号徽章（左上） -->
                                        <Border Background="#C01D6BE5" CornerRadius="4"
                                                Padding="5,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="6,6,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SequenceNumber}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontSize="10" FontWeight="Bold"
                                                       FontFamily="{StaticResource FontFamilyMono}">
                                                <Run Text="#" /><Run Text="{Binding SequenceNumber, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>

                                        <!-- 时长 badge（右下）。播放时隐藏，避免挡住播放控制栏右侧的总时长数字。
                                             显隐走 VM 的 DurationBadgeVisible 绑定，不由后台代码直接改 Visibility
                                             —— 后者在容器复用时会把「已隐藏」漂到别的卡上（见 VM 里的说明）。 -->
                                        <Border x:Name="CardDurationBadge"
                                                Background="#A0000000" CornerRadius="4"
                                                Padding="6,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,6,6"
                                                Visibility="{Binding DurationBadgeVisible, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{Binding TimeRangeDisplay}">
                                            <TextBlock Text="{Binding DurationDisplay}"
                                                       Foreground="White" FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- 多选标记（右上） -->
                                        <Border Width="24" Height="24"
                                                BorderBrush="#C01D6BE5" BorderThickness="2"
                                                CornerRadius="999"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,6,6,0"
                                                Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#A0FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✓" Foreground="White"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}}" />
                                        </Border>

                                        <!-- 缩略图整块点击 =（重新）播放（§H：整张缩略图都是点击区，不止小 ▶）。
                                             Background=Transparent 让整块参与命中测试（否则只有中间那个小 ▶ 可点，
                                             用户点缩略图别处会以为「点了不播」）。
                                             OnCardClicked 走 PreviewMouseLeftButtonDown 隧道阶段先收到、仍能选中弹变体池，两者不冲突。
                                             显隐 = 非多选态且当前没在播（多选态点击用于勾选），全部走 VM 绑定，
                                             后台代码不再直接改 Visibility —— 容器复用时那会漂到别的卡上。 -->
                                        <Grid x:Name="PlayOverlay" Background="Transparent" Cursor="Hand"
                                              MouseLeftButtonUp="OnPlayOverlayClick"
                                              Visibility="{Binding PlayOverlayVisible, Converter={StaticResource BoolToVisibility}}">
                                            <Border Background="#90000000" CornerRadius="999" Width="46" Height="46"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" Foreground="White" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="3,0,0,0" />
                                            </Border>
                                        </Grid>

                                        <!-- P3：字幕遮挡框 + 字号预览（叠在缩略图上）。未保留原声即显示（三种字幕处理都要预览字号）；
                                             遮挡蓝框仅「模糊虚化 / 纯色遮挡」时由 ShowMaskBox 显示。 -->
                                        <sl:SubtitleMaskOverlay Rect="{Binding MaskRect, Mode=TwoWay}"
                                                                CommitCommand="{Binding CommitMaskCommand}"
                                                                ShowMaskBox="{Binding NeedsMaskEditor}"
                                                                SegmentFontRatio="{Binding SegmentFontRatio, Mode=OneWay}"
                                                                Visibility="{Binding SubtitlePreviewVisible, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- #12：切换画面胶囊（左下，仅有 AI 替换画面时显示）。点击在原画面 ↔ 替换画面来回切；
                                             替换态绿底、原画面态黑底（对齐 mac）。右键菜单另有「删除替换画面」彻底还原。 -->
                                        <Border CornerRadius="999" Padding="6,3" Cursor="Hand"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"
                                                MouseLeftButtonUp="OnTogglePictureClick"
                                                ToolTip="AI 替换画面：点击在原画面 / 替换画面间切换（右键可删除替换画面）"
                                                Visibility="{Binding HasReplacedPicture, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#99000000" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PictureShowsReplaced}" Value="True">
                                                            <Setter Property="Background" Value="#D92E8B57" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↻" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0,0,3,0" />
                                                <TextBlock Text="{Binding PictureToggleLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- #17/#18：处理中占位遮罩（识别中 / 打标中 / 重新识别），盖最上层挡住播放/交互 -->
                                        <Border Background="#B0000000" CornerRadius="6"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ProgressBar IsIndeterminate="True" Width="64" Height="4"
                                                             Foreground="White" Background="#40FFFFFF" BorderThickness="0" />
                                                <TextBlock Text="{Binding ProcessingText}" Foreground="White"
                                                           FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"
                                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 语义标签 + 位置 + 质量分：**同一个 WrapPanel**，胶囊连续流动（对齐 mac FlowLayout）。
                                     语义标签少时三者在一行；多时自然折行，不会像拆两行那样恒定多占一行。 -->
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding SemanticTypes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999" Padding="7,2" Margin="0,0,4,4"
                                                        Background="{Binding ., Converter={StaticResource SemanticTypeToTintBrush}}">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource SemanticTypeToLabel}}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding ., Converter={StaticResource SemanticTypeToBrush}}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border CornerRadius="999" Padding="7,2" Margin="0,0,4,4"
                                            Background="#15888888">
                                        <TextBlock Text="{Binding PositionType, Converter={StaticResource PositionTypeToLabel}}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="999" Padding="7,2" Margin="0,0,4,4"
                                            Background="#152E8B57">
                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding QualityScore, Converter={StaticResource QualityScoreToBrush}}">
                                            <Run Text="★ " /><Run Text="{Binding QualityScore, Mode=OneWay, StringFormat={}{0:F1}}" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>

                                <!-- 字幕处理（P3）：保留原声 + 三胶囊 + 遮挡区应用 -->
                                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                    <!-- 保留原声开关 -->
                                    <CheckBox IsChecked="{Binding IsVoiceLocked, Mode=OneWay}" Command="{Binding ToggleVoiceLockCommand}"
                                              Cursor="Hand" Content="🔒 保留原声"
                                              FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />

                                    <!-- 字幕处理（未锁定才显示） -->
                                    <StackPanel Margin="0,4,0,0"
                                                Visibility="{Binding IsVoiceLocked, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="字幕处理" FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium"
                                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,3" />
                                        <WrapPanel>
                                            <Button Content="直接烧录" Command="{Binding SetTreatmentCommand}" CommandParameter="Direct"
                                                    ToolTip="不处理背景，直接把新字幕烧上去"
                                                    Padding="7,3" FontSize="10" Margin="0,0,4,4" Cursor="Hand"
                                                    BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <!-- 默认色必须放 Style Setter，不能写成 Button 本地属性：本地值优先级高于 Style 触发器，
                                                             一旦写在 Button 上，下面选中态 DataTrigger 的 Background/Foreground 会被永久覆盖→胶囊永不高亮。 -->
                                                        <Setter Property="Background" Value="{StaticResource BgQuaternaryBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubtitleTreatment}" Value="Direct">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="模糊虚化" Command="{Binding SetTreatmentCommand}" CommandParameter="Blur"
                                                    ToolTip="把字幕区域糊掉再烧（不管有没有旧字幕都可用）"
                                                    Padding="7,3" FontSize="10" Margin="0,0,4,4" Cursor="Hand"
                                                    BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource BgQuaternaryBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubtitleTreatment}" Value="Blur">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="纯色遮挡" Command="{Binding SetTreatmentCommand}" CommandParameter="Solid"
                                                    ToolTip="深色条盖住该区域再烧"
                                                    Padding="7,3" FontSize="10" Margin="0,0,4,4" Cursor="Hand"
                                                    BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource BgQuaternaryBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubtitleTreatment}" Value="Solid">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </WrapPanel>
                                        <!-- 遮挡区应用到所有分镜（模糊/纯色才显示） -->
                                        <Button Content="⊞ 遮挡区应用到所有分镜" Command="{Binding ApplyMaskToAllCommand}"
                                                Visibility="{Binding NeedsMaskEditor, Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0" FontSize="10"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                ToolTip="把本分镜的字幕处理方式与遮挡框复制到同一视频的其它分镜" />

                                        <!-- 字幕字号（逐分镜，issue #23 后续）：每张卡自己的滑块，只改本分镜
                                            （Segment.SubtitleFontRatio，拖动实时预览、松手落库）。
                                             未单独调过的分镜显示当前默认值，一经拖动即钉住自己的字号。 -->
                                        <StackPanel Margin="0,8,0,0">
                                            <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="字幕字号" FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Text="{Binding FontPercentText}" />
                                            </DockPanel>
                                            <!-- Min/Max = SubtitleFontSize.MinRatio/MaxRatio (0.030~0.085)，Height=18 对齐 mac mini -->
                                            <Slider Height="18" Minimum="0.030" Maximum="0.085" SmallChange="0.002" LargeChange="0.005"
                                                    Value="{Binding FontRatio, Mode=TwoWay}"
                                                    ToolTip="本分镜的字幕字号（每个分镜独立）。拖动时上方画面里的示例字幕会实时变化，可与原视频字幕对比大小。" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 台词块（右列，跨全高常显；对齐 mac：大而可读，hover 显 ✏ 编辑 / ↻ 重识别） -->
                                <Border Grid.Column="2" Grid.RowSpan="4"
                                        Background="{StaticResource BgSubtleBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0">
                                    <Border.Resources>
                                        <!-- 台词区图标按钮统一样式（✏ ↻ ✓ ✕）：透明底、圆角、hover 高亮 -->
                                        <Style x:Key="TranscriptIconBtn" TargetType="Button">
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="18" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlueLightBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Resources>
                                    <!-- 标题行常显（含 ✏/↻ 操作），下方 body 三态：编辑 / 有词 / 无词 -->
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💬" FontSize="{StaticResource FontSizeCaption}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="台词" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           Foreground="{StaticResource TextQuaternaryBrush}"
                                                           VerticalAlignment="Center" Margin="2,0,0,0">
                                                    <Run Text=" · " /><Run Text="{Binding TranscriptCharCount, Mode=OneWay}" /><Run Text="字" />
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- 非编辑态：✏ 编辑 + ↻ 重识别（hover/选中显示；空台词也显示，可直接输入/重识别） -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding TranscriptActionsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="✏" Command="{Binding BeginEditTextCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}" ToolTip="编辑台词" />
                                                <Button Content="↻" Command="{Binding ReRecognizeCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        ToolTip="用阿里云 ASR 重新识别该分镜台词（替换原台词）" />
                                                <!-- 快速编辑菜单（语义类型 / 位置类型 / 拆分 / 删除等）。
                                                     原本在帧边界区底部单占一行，为压缩卡片高度移到这里与 ✏ ↻ 并列。 -->
                                                <Button x:Name="QuickEditBtn" Content="⋯"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        Tag="{Binding}" Click="OnQuickEditClick"
                                                        ToolTip="更多操作（语义类型 / 位置 / 拆分 / 删除）" />
                                            </StackPanel>
                                            <!-- 编辑态：✓ 保存 + ✕ 取消 -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="✓" Command="{Binding SaveTextCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        Foreground="{StaticResource SuccessGreenBrush}" ToolTip="保存（Ctrl+Enter）" />
                                                <Button Content="✕" Command="{Binding CancelEditTextCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        Foreground="{StaticResource TextTertiaryBrush}" ToolTip="取消（Esc）" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <!-- 编辑态：TextBox（双向绑 DraftText，Ctrl+Enter 保存 / Esc 取消） -->
                                            <TextBox Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVisibility}}"
                                                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     MinHeight="48" MaxHeight="160"
                                                     FontSize="11"
                                                     IsVisibleChanged="TranscriptEditBox_IsVisibleChanged"
                                                     Background="{StaticResource BgPrimaryBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1"
                                                     Padding="5,3">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Modifiers="Control" Key="Return" Command="{Binding SaveTextCommand}" />
                                                    <KeyBinding Key="Escape" Command="{Binding CancelEditTextCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <!-- 有台词只读态 -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding TranscriptReadonlyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TranscriptText}"
                                                           FontSize="12.5" TextWrapping="Wrap"
                                                           LineHeight="20"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </ScrollViewer>
                                            <!-- 无台词占位 -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding TranscriptEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="🔇" FontSize="11"
                                                           Foreground="{StaticResource TextQuinaryBrush}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="暂无台词，点 ✏ 手写或 ↻ 重识别" FontSize="10"
                                                           Foreground="{StaticResource TextQuaternaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <!-- 帧边界 IN/OUT：**常驻、紧凑两行**。
                                     演进过程（别再走回头路）：
                                     ① 最早是带「帧边界」标题 + 边框 + 末帧行的大面板，~150px，把卡片撑到 660 高
                                        → 全屏一屏看不到一整行，用户反馈「大片空白只有一列」；
                                     ② 试过对齐 mac 的「hover/选中才显示」，但 mac 的展开态只有 24pt、
                                        Windows 这块有 ~100px，无论做等高占位（高度白还给卡片、等于没瘦身）
                                        还是做浮层（会盖住下面的字幕处理，用户明确不接受）都不成立；
                                     ③ 最终：砍掉标题行与末帧行（信息移进 ToolTip）、去掉边框背景，压成两行 ~62px 常驻。
                                        既不遮挡任何内容，又比最初省下 ~90px。 -->
                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                <Border Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="IN" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="起点帧号。− / + 每次调 1 帧" />
                                            <Button Grid.Column="1" Content="−"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="起点向前一帧"
                                                    Command="{Binding AdjustStartCommand}"
                                                    CommandParameter="-1" />
                                            <!-- 中间显示**帧号**，也可手动输入帧号 → 回车 / 失焦生效（OnStartLostFocus→CommitStart）。
                                                 单位必须与 −/+ 一致：这两个按钮一次调 1 帧，若这里显示秒，点一下只动 0.04，
                                                 用户完全对不上自己在调什么。ToolTip 给剪映式时间码（时:分:秒:帧）。 -->
                                            <Border Grid.Column="2" Height="28" Margin="5,0"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <TextBox Text="{Binding StartFrameText, Mode=OneWay}"
                                                         Tag="{Binding}"
                                                         LostKeyboardFocus="OnStartLostFocus"
                                                         KeyDown="OnStartKeyDown"
                                                         ToolTip="{Binding StartTimecode}"
                                                         FontFamily="{StaticResource FontFamilyMono}"
                                                         FontSize="10" FontWeight="SemiBold"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         Background="Transparent" BorderThickness="0"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         VerticalAlignment="Stretch" />
                                            </Border>
                                            <Button Grid.Column="3" Content="+"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="起点向后一帧"
                                                    Command="{Binding AdjustStartCommand}"
                                                    CommandParameter="1" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="OUT" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="终点帧号（不含该帧）。− / + 每次调 1 帧" />
                                            <Button Grid.Column="1" Content="−"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="终点向前一帧"
                                                    Command="{Binding AdjustEndCommand}"
                                                    CommandParameter="-1" />
                                            <!-- 终点同样可手动输入**帧号**（回车 / 失焦生效，走 OnEndLostFocus→CommitEnd）；
                                                 结束边界不含该帧，实际末帧见 ToolTip。 -->
                                            <Border Grid.Column="2" Height="28" Margin="5,0"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <TextBox Text="{Binding EndFrameText, Mode=OneWay}"
                                                         Tag="{Binding}"
                                                         LostKeyboardFocus="OnEndLostFocus"
                                                         KeyDown="OnEndKeyDown"
                                                         FontFamily="{StaticResource FontFamilyMono}"
                                                         FontSize="10" FontWeight="SemiBold"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         Background="Transparent" BorderThickness="0"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         VerticalAlignment="Stretch">
                                                    <!-- 末帧时间码 + 帧率原本占卡片一整行，压缩高度后移进这里，悬停即见 -->
                                                    <TextBox.ToolTip>
                                                        <TextBlock>
                                                            <Run Text="终点 " /><Run Text="{Binding EndTimecode, Mode=OneWay}" /><LineBreak />
                                                            <Run Text="结束边界不含最后一帧，实际停在 " /><Run Text="{Binding LastFrameTimecode, Mode=OneWay}" /><LineBreak />
                                                            <Run Text="{Binding FrameRateDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </TextBox.ToolTip>
                                                </TextBox>
                                            </Border>
                                            <Button Grid.Column="3" Content="+"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="终点向后一帧"
                                                    Command="{Binding AdjustEndCommand}"
                                                    CommandParameter="1" />
                                        </Grid>

                                        <!-- 原本这里还有一行「末帧 00:13:01 · 24 fps」+「更多」按钮，为压缩高度已移走：
                                             末帧时间码与帧率进了 OUT 输入框的 ToolTip（悬停即见），
                                             「更多」菜单移到台词面板 header，与 ✏ / ↻ 并列。 -->
                                    </StackPanel>
                                </Border>
                                </Grid>
                            </Grid>
                        </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </DockPanel>
</UserControl>
