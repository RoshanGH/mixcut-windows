<Window x:Class="MixCut.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="/Resources/AppIcon.ico" Width="560" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <DockPanel Margin="20">
        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#E5E5E7" BorderThickness="0,1,0,0"
                Margin="0,12,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="18,7" IsCancel="True" />
            </StackPanel>
        </Border>

        <TabControl Padding="0" BorderThickness="0" Background="White">
            <!-- API -->
            <TabItem Header="API">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="AI 提供商" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,8" />
                        <ComboBox x:Name="ProviderCombo" Padding="6,5" Margin="0,0,0,18"
                                  SelectionChanged="OnProviderChanged" />

                        <TextBlock x:Name="SectionHeader" Text="提供商配置"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />

                        <TextBlock Text="API Key" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ApiKeyBox" Padding="6,5"
                                     FontFamily="Consolas, Cascadia Mono, monospace" />
                            <!-- Padding=0：隐式 Button 样式的 12,6 会把 32 宽按钮的内容区压到 8px，图标被压扁 -->
                            <Button Grid.Column="1" x:Name="ToggleVisibilityButton"
                                    Width="32" Padding="0" Margin="6,0,0,0" Click="OnToggleVisibility"
                                    Background="White" BorderBrush="{StaticResource TextDisabledBrush}"
                                    ToolTip="显示/隐藏 API Key">
                                <TextBlock x:Name="EyeIcon" Text="👁" FontSize="13" />
                            </Button>
                        </Grid>

                        <StackPanel x:Name="RelayPanel" Visibility="Collapsed">
                            <TextBlock Text="转发网关地址" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                            <TextBox x:Name="RelayUrlBox" Padding="6,5" Margin="0,0,0,4"
                                     FontFamily="Consolas, Cascadia Mono, monospace" />
                            <TextBlock Text="要求兼容 OpenAI 协议的转发网关地址"
                                       FontSize="10" Foreground="#999" Margin="0,0,0,12" />

                            <TextBlock Text="网关平台" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                            <ComboBox x:Name="RelayPlatformCombo" Padding="6,5" Margin="0,0,0,14"
                                      SelectionChanged="OnRelayPlatformChanged" />
                        </StackPanel>

                        <StackPanel x:Name="CustomPanel" Visibility="Collapsed">
                            <TextBlock Text="API 地址" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                            <TextBox x:Name="CustomUrlBox" Padding="6,5" Margin="0,0,0,12"
                                     FontFamily="Consolas, Cascadia Mono, monospace" />
                            <TextBlock Text="模型名称" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                            <TextBox x:Name="CustomModelBox" Padding="6,5" Margin="0,0,0,14"
                                     FontFamily="Consolas, Cascadia Mono, monospace" />
                        </StackPanel>

                        <TextBlock Text="模型" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                        <ComboBox x:Name="ModelCombo" Padding="6,5" IsEditable="True"
                                  Margin="0,0,0,4"
                                  SelectionChanged="OnModelComboSelectionChanged" />
                        <TextBlock x:Name="ModelHelpText" FontSize="10" Foreground="#888"
                                   Margin="0,0,0,12" Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SavedBadge" Text="✓ 已保存"
                                       FontSize="11" Foreground="#2E8B57" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,0,0,0">
                                <Button x:Name="ClearKeyButton" Content="清除"
                                        Padding="14,5" Margin="8,0,0,0"
                                        Background="White" BorderBrush="#D33" Foreground="#D33"
                                        Click="OnClearKey" Visibility="Collapsed" />
                                <Button x:Name="SaveKeyButton" Content="保存"
                                        Padding="14,5" Margin="8,0,0,0"
                                        Background="#1D6BE5" Foreground="White" BorderThickness="0"
                                        Click="OnSaveKey" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 占位让左侧 SavedBadge 不挤到边 -->
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 通用 -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel x:Name="GeneralPanel">
                        <!-- 视频处理 -->
                        <TextBlock Text="视频处理" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />
                        <Grid x:Name="DependencyGrid" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- Whisper 模型下载状态 -->
                        <Border x:Name="ModelDownloadBox" Background="#FFF8E1"
                                BorderBrush="#FFD080" BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,4,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ModelStatusText" FontSize="12"
                                           Foreground="#7A5800" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" x:Name="ModelProgress"
                                                 Height="6" Maximum="1" />
                                    <Button Grid.Column="1" x:Name="CancelDownloadButton"
                                            Content="✕ 取消" Padding="10,4"
                                            Margin="10,0,0,0" Click="OnCancelDownload"
                                            Background="White" BorderBrush="#CCC"
                                            FontSize="11" Cursor="Hand"
                                            Visibility="Collapsed" />
                                    <Button Grid.Column="2" x:Name="DownloadModelButton"
                                            Content="下载模型 (~1.6GB)" Padding="12,4"
                                            Margin="10,0,0,0" Click="OnDownloadModel"
                                            Background="#F0AD4E" Foreground="White" BorderThickness="0" />
                                </Grid>
                                <!-- 实时速度（仅下载中显示） -->
                                <TextBlock x:Name="ModelSpeedText" FontSize="10" Foreground="#7A5800"
                                           Margin="0,4,0,0" FontFamily="Consolas, monospace"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="ModelErrorText" FontSize="11" Foreground="#D33"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- 存储 -->
                        <TextBlock Text="存储" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,8,0,10" />
                        <StackPanel x:Name="PathPanel" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button x:Name="OpenDataDirButton" Content="📂  在资源管理器中打开"
                                    Padding="12,5" Margin="0,0,8,0"
                                    Background="White" BorderBrush="#CCC"
                                    Click="OnOpenDataDir" />
                            <Button x:Name="ChangeDataDirButton" Content="📁  更改存储位置…"
                                    Padding="12,5" Margin="0,0,8,0"
                                    Background="White" BorderBrush="#CCC"
                                    Click="OnChangeDataDir" />
                            <Button x:Name="ResetDataDirButton" Content="↩  恢复默认(C盘)"
                                    Padding="12,5"
                                    Background="White" BorderBrush="#CCC"
                                    Click="OnResetDataDir" />
                        </StackPanel>
                        <TextBlock Text="视频原片与语音模型都存在这里。装在小容量 C 盘时，可改到空间更大的盘。更改后需重启完成迁移。"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- 系统信息 -->
                        <TextBlock Text="系统信息" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,8,0,10" />
                        <StackPanel x:Name="SystemInfoPanel" Margin="0,0,0,16" />

                        <!-- 关于 -->
                        <TextBlock Text="关于" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,8,0,10" />
                        <StackPanel x:Name="AboutPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Agent 接入（issue #23：内嵌 MCP server） -->
            <TabItem Header="Agent">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel>
                        <!-- 区块 1 · 本机 Agent 接入（MCP） -->
                        <TextBlock Text="本机 Agent 接入（MCP）" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />
                        <CheckBox x:Name="AgentEnabledCheck" Content="启用 Agent 服务"
                                  FontSize="12" Margin="0,0,0,8"
                                  Checked="OnAgentEnabledChanged" Unchecked="OnAgentEnabledChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="端口" FontSize="12" Foreground="#666"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="AgentPortBox" Width="90" Padding="6,4"
                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                     KeyDown="OnAgentPortKeyDown" LostFocus="OnAgentPortLostFocus" />
                        </StackPanel>
                        <TextBlock Text="服务只监听 127.0.0.1，仅本机可访问。改端口后回车生效。"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <!-- 区块 2 · 注册到 Agent 客户端 -->
                        <TextBlock Text="注册到 Agent 客户端" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />
                        <ComboBox x:Name="AgentClientCombo" Padding="6,5" Margin="0,0,0,8"
                                  SelectionChanged="OnAgentClientChanged" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="AgentSnippetBox" IsReadOnly="True"
                                     Padding="8,6" FontSize="11" TextWrapping="Wrap"
                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                     Background="#F7F7F8" BorderBrush="#E0E0E2"
                                     VerticalScrollBarVisibility="Auto" />
                            <Button Grid.Column="1" Content="复制" Padding="14,5" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="White" BorderBrush="#CCC" Click="OnCopyAgentSnippet" />
                        </Grid>
                        <TextBlock x:Name="AgentClientHint" FontSize="11" Foreground="#888"
                                   TextWrapping="Wrap" Margin="0,0,0,18" />

                        <!-- 区块 3 · 注册后验证 -->
                        <TextBlock Text="注册后验证（把这句话复制给 Agent 执行）" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="AgentVerifyBox" IsReadOnly="True"
                                     Padding="8,6" FontSize="11" TextWrapping="Wrap"
                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                     Background="#F7F7F8" BorderBrush="#E0E0E2" />
                            <Button Grid.Column="1" Content="复制" Padding="14,5" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="White" BorderBrush="#CCC" Click="OnCopyAgentVerify" />
                        </Grid>
                        <TextBlock Text="预期返回：你的项目清单，与 MixCut 侧边栏一致（含状态、视频数、分镜数）。能列出来即注册成功；若 Agent 说找不到工具或连接失败，确认 MixCut 正在运行、端口一致后重试。"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <!-- 区块 4 · 指挥示例（纯展示，无复制按钮） -->
                        <TextBlock Text="可以这样指挥 Agent（仅示例，按你的实际项目和分镜说）" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />
                        <TextBlock Text="「把项目一里 1 号视频的 3 到 5 号分镜标签改成痛点，字幕换成纯色遮挡，结尾都延 10 帧」"
                                   FontSize="12" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="「把这个文件夹里的 20 条视频导入新项目跑分析，失败的汇总告诉我」"
                                   FontSize="12" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="「用 1 号视频的 1、2 号分镜加 2 号视频的 4 号分镜组个方案，导出到桌面」"
                                   FontSize="12" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="视频编号看素材导入页卡片左上角的「N 号」徽章，分镜编号看分镜卡片的 # 号；一句话可以带多个操作，Agent 会自己拆解执行。"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <!-- 区块 5 · 能力清单（从工具目录动态渲染） -->
                        <TextBlock x:Name="AgentToolsHeader" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,10" />
                        <StackPanel x:Name="AgentToolsPanel" Margin="0,0,0,8" />
                        <TextBlock Text="以上是 Agent 的全部权限边界：不能拆分分镜、不能做画面替换变体。删除项目需 Agent 二次确认（先返回影响预览）；删除分镜/视频/项目执行后无撤销。"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
