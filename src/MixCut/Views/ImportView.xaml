<UserControl x:Class="MixCut.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:MixCut.Views.Components"
             Background="White" AllowDrop="True"
             Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">
    <DockPanel Margin="24">
        <!-- 顶部：标题 + 导入按钮 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="素材导入" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="选择视频文件" HorizontalAlignment="Right" Padding="18,8"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnImportClick" />
        </Grid>

        <!-- 处理进度横幅 -->
        <Border DockPanel.Dock="Top" x:Name="ProgressPanel" Background="#E7F0FF"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PhaseText" FontSize="12" FontWeight="SemiBold" Foreground="#1D6BE5" />
                    <TextBlock x:Name="ProgressText" FontSize="11" Foreground="#666" Margin="0,2,0,0" />
                </StackPanel>
                <ProgressBar Grid.Column="1" x:Name="ProgressBar" Height="6"
                             Maximum="1" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 错误横幅 -->
        <Border DockPanel.Dock="Top" x:Name="ErrorBanner" Background="#FFF5E0"
                BorderBrush="#FFD080" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#7A5800"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="✕" Padding="6,2" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnDismissError" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- 拖拽区：虚线边框（剪映式「可投放」视觉语言）。边框走 Rectangle StrokeDashArray，
             Stroke 仍用同名 DropBorderBrush、底色仍在 Border 上 —— 拖拽 hover 高亮逻辑（code-behind）不变。 -->
        <Border DockPanel.Dock="Top" x:Name="DropZone"
                CornerRadius="14" Margin="0,0,0,16">
            <Border.Background>
                <SolidColorBrush x:Name="DropBackgroundBrush" Color="#FAFAFA" />
            </Border.Background>
            <Grid MinHeight="134">
                <Rectangle RadiusX="14" RadiusY="14" Margin="1"
                           StrokeThickness="2" StrokeDashArray="4 3" StrokeDashCap="Round"
                           SnapsToDevicePixels="True">
                    <Rectangle.Stroke>
                        <SolidColorBrush x:Name="DropBorderBrush" Color="#CCCCCC" />
                    </Rectangle.Stroke>
                </Rectangle>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DropIcon" Text="⬇" FontSize="36" Foreground="#999"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropMainText" Text="拖拽视频文件到此处" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="支持 MP4 / MOV / AVI / M4V / MKV"
                               FontSize="11" Foreground="#999"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 视频列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid x:Name="VideoListHeader" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="已导入视频" FontSize="12" FontWeight="SemiBold"
                               Foreground="#666" />
                    <TextBlock x:Name="VideoCountText" FontSize="11" Foreground="#999"
                               HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl x:Name="VideoList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 双栏卡片：左视频/信息 195px + 1px 分隔 + 右台词滚动 195px。对齐 macOS 版 ImportedVideoCard -->
                            <Border BorderBrush="#E5E5E7" BorderThickness="1" CornerRadius="10"
                                    Margin="0,0,12,12" Background="White" Width="420">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制文件名" Click="OnCopyName" Tag="{Binding}" />
                                        <MenuItem Header="复制全部台词（带时间）" Click="OnCopyAllLyrics" Tag="{Binding}" />
                                        <MenuItem Header="在资源管理器中显示" Click="OnShowInExplorer" Tag="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="删除视频" Click="OnDeleteVideoMenu" Tag="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="195" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧状态边带（失败红/完成绿，处理中/已导入不显示）-->
                                    <Border Grid.Column="0" Background="#D33A3A"
                                            Visibility="{Binding FailedStripVisibility}" CornerRadius="10,0,0,10" />
                                    <Border Grid.Column="0" Background="#2E8B57"
                                            Visibility="{Binding CompletedStripVisibility}" CornerRadius="10,0,0,10" />

                                    <!-- 左侧面板：视频 + 信息 -->
                                    <StackPanel Grid.Column="1" Margin="10,10,10,10">
                                        <!-- 播放器（status 稳定时显示）-->
                                        <Border Background="Black" CornerRadius="8" ClipToBounds="True"
                                                Height="240"
                                                Visibility="{Binding InlinePlayerVisibility}">
                                            <comp:InlineVideoPlayer Loaded="OnInlinePlayerLoaded"
                                                                    Tag="{Binding}" />
                                        </Border>
                                        <!-- 静态缩略图 + 状态遮罩 + 实时进度（处理中/失败时显示）-->
                                        <Border Background="Black" CornerRadius="8" ClipToBounds="True"
                                                Height="240"
                                                Visibility="{Binding StaticThumbnailVisibility}">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" />
                                                <!-- 处理中：半透明遮罩 + spinner + 阶段文字 + 底部进度条 -->
                                                <Border Background="#A0000000"
                                                        Visibility="{Binding BusyOverlayVisibility}">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- WPF 内置无限进度条（旋转条形） -->
                                                            <ProgressBar IsIndeterminate="True" Height="3" Width="120"
                                                                         Foreground="#1D6BE5"
                                                                         Background="#40FFFFFF"
                                                                         BorderThickness="0" />
                                                            <TextBlock Text="{Binding StageLabel}" Foreground="White"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" Margin="0,10,0,0"
                                                                       TextWrapping="Wrap" TextAlignment="Center" />
                                                        </StackPanel>
                                                        <!-- 底部 3px 进度条（百分比） -->
                                                        <ProgressBar Value="{Binding ProgressOverall, Mode=OneWay}"
                                                                     Maximum="1" Height="3"
                                                                     VerticalAlignment="Bottom"
                                                                     Foreground="#1D6BE5"
                                                                     Background="#30FFFFFF"
                                                                     BorderThickness="0" />
                                                    </Grid>
                                                </Border>
                                                <!-- 失败：暗色蒙版（缩略图仍可辨识）+ 红色圆形 ✕ 徽章 + 文字。
                                                     失败语义已由左侧红边带 / 红状态徽章 / 红错误文案 / 重试按钮四处表达，
                                                     这里不再用整张红色洪水盖住画面（商用标准：状态清晰但画面可辨）。-->
                                                <Border Background="#99000000"
                                                        Visibility="{Binding FailedStripVisibility}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Background="#E5D33A3A" CornerRadius="999"
                                                                Width="44" Height="44" HorizontalAlignment="Center">
                                                            <TextBlock Text="✕" Foreground="White" FontSize="22"
                                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="处理失败" Foreground="White" FontSize="12"
                                                                   FontWeight="SemiBold" Margin="0,8,0,0"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 文件名 -->
                                        <TextBox Text="{Binding Name, Mode=OneWay}" Margin="0,8,0,0"
                                                 FontSize="11" FontWeight="Medium"
                                                 IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" TextWrapping="Wrap"
                                                 MaxHeight="36" ToolTip="{Binding Name}" />

                                        <!-- meta -->
                                        <TextBlock Text="{Binding MetaText}" FontSize="10"
                                                   Foreground="#888" Margin="0,4,0,0" />

                                        <!-- 处理流水线 -->
                                        <Border Background="{Binding PipelineBackground}" CornerRadius="6"
                                                Padding="6,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding PipelineVisibility}">
                                            <TextBlock Text="{Binding PipelineText}" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="#333" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- 状态徽章 + 重试 -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding BadgeBackground}"
                                                    CornerRadius="999" Padding="7,2">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="{Binding BadgeForeground}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Button Grid.Column="2" Content="重试" Padding="8,2"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    FontSize="10" Tag="{Binding}" Click="OnRetryClick"
                                                    Visibility="{Binding RetryVisibility}" />
                                        </Grid>

                                        <!-- 错误信息 -->
                                        <TextBlock Text="{Binding ErrorText}" FontSize="10" Foreground="#D33"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding ErrorVisibility}" />

                                        <!-- 分镜类型分布 -->
                                        <TextBlock Text="{Binding SegmentTagsText}" FontSize="10"
                                                   Foreground="#1D6BE5" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding SegmentTagsVisibility}" />
                                    </StackPanel>

                                    <!-- 分隔线 -->
                                    <Border Grid.Column="2" Background="#EEEEEE" Margin="0,12" />

                                    <!-- 右侧台词面板（可滚动）-->
                                    <DockPanel Grid.Column="3" Margin="10,10,10,10">
                                        <DockPanel.Resources>
                                            <!-- 台词面板仅 195px 宽：动作一律做成紧凑圆角图标按钮，否则文字会挤成一团/相互遮挡。
                                                 对齐 Mac —— 复制/重识别都用图标。 -->
                                            <Style x:Key="ImportTranscriptIconBtn" TargetType="Button">
                                                <Setter Property="Width" Value="24" />
                                                <Setter Property="Height" Value="20" />
                                                <Setter Property="Margin" Value="4,0,0,0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Background" Value="#F0F0F3" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.82" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Resources>
                                        <!-- 标题栏：左「🎙 台词·N字」，右侧一排紧凑图标（复制 / AI 重识别 / 重做）。 -->
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎙" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="台词" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#888" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TranscriptCharText}"
                                                           FontSize="{StaticResource FontSizeCaption}" Foreground="#AAA"
                                                           FontFamily="Consolas, monospace"
                                                           VerticalAlignment="Center" Margin="5,1,0,0" />
                                            </StackPanel>
                                            <!-- 右侧动作图标：复制(蓝) / AI 重识别(阿里·紫) / 重做(本地 whisper·橙，仅分句异常)。
                                                 对齐 Mac 台词面板「本地 + AI」双重识别入口。 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Visibility="{Binding SentencesVisibility}" Tag="{Binding}" Click="OnCopyAllLyrics"
                                                        Style="{StaticResource ImportTranscriptIconBtn}"
                                                        Foreground="#1D6BE5" Content="📋"
                                                        ToolTip="复制全部台词（带起止时间，可粘贴到文档/表格）" />
                                                <Button Visibility="{Binding AiReidentifyVisibility}" Tag="{Binding}" Click="OnReidentifyAiClick"
                                                        Style="{StaticResource ImportTranscriptIconBtn}"
                                                        Background="#EDE6FA" Foreground="#6A3FB5" Content="↻"
                                                        ToolTip="AI 重识别台词：用阿里云 ASR 逐分镜重新识别，刷新台词（不重跑 whisper、不动分镜边界）" />
                                                <Button Visibility="{Binding AsrRedoVisibility}" Tag="{Binding}" Click="OnRedoAsrClick"
                                                        Style="{StaticResource ImportTranscriptIconBtn}"
                                                        Background="#FCEBD2" Foreground="#C06F00" Content="↺"
                                                        ToolTip="ASR 分句较粗，点击重跑本地 whisper 重新识别（本地识别）" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- ASR 异常提示条 -->
                                        <Border DockPanel.Dock="Top"
                                                Visibility="{Binding AsrAbnormalHintVisibility}"
                                                Background="#FFF7E8" CornerRadius="4"
                                                Padding="6,3" Margin="0,0,0,4">
                                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="#7A5800"
                                                       TextWrapping="Wrap"
                                                       Text="⚠ 分句较粗，可点击右上「重做」重新识别" />
                                        </Border>

                                        <!-- 空状态：暂无台词 -->
                                        <StackPanel DockPanel.Dock="Top"
                                                    Visibility="{Binding EmptyTranscriptVisibility}"
                                                    HorizontalAlignment="Center" Margin="0,40,0,0">
                                            <TextBlock Text="⌛" FontSize="20" Foreground="#CCC"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="暂无台词" FontSize="11" Foreground="#AAA"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- 句子列表：用 VirtualizingStackPanel 虚拟化，单视频 100+ 句不卡。
                                             对齐 macOS v0.2.5 commit 6530fd6 的「全板块懒加载补齐」。 -->
                                        <ScrollViewer Visibility="{Binding SentencesVisibility}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="True"
                                                      MaxHeight="320">
                                            <ItemsControl ItemsSource="{Binding Sentences}"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                                       FontSize="{StaticResource FontSizeCaption}" Foreground="#BBB"
                                                                       FontFamily="Consolas, monospace"
                                                                       TextAlignment="Right"
                                                                       Margin="0,1,4,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                                       FontSize="11" Foreground="#333"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="16" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>

                                    <!-- 视频编号徽章（issue #23）：与 Agent 指令里的 video_no 同一套编号
                                         （「1 号视频」即此号）。左上角覆盖层，不拦截鼠标事件。 -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="4"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="6" Padding="8,3" CornerRadius="999"
                                            Background="#9E000000" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding VideoNoText}" Foreground="White"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
